# service-account.json への絶対パス（setup-ga4-gsc.md 手順1で取得。gitにコミット禁止）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Search Console のプロパティ表記と完全一致させる
#   URLプレフィックス型: https://tigerlabo.com/
#   ドメインプロパティ型: sc-domain:tigerlabo.com
GSC_SITE_URL=https://tigerlabo.com/

# GA4 プロパティID（数字。測定ID G-XXXX とは別物。GA4 管理→プロパティ設定）
GA4_PROPERTY_ID=000000000
