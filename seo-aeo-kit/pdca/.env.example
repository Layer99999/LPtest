# ─────────────────────────────────────────────────────────────
# ローカルで動かす場合はこのファイルを .env にコピーして値を入れる。
# クラウド（Claude Code の環境変数）で動かす場合は、.env ではなく
# 環境の「シークレット/環境変数」に GOOGLE_SERVICE_ACCOUNT_JSON を入れる。
# ─────────────────────────────────────────────────────────────

# 【クラウド運用・推奨】鍵JSONの「中身」を丸ごと1行で貼る（環境のシークレットに設定）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# 【ローカル運用】鍵JSONファイルへの絶対パス（gitにコミット禁止）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# サイトURL・GA4プロパティIDは通常 config.json に記載済みなので設定不要。
# 上書きしたい場合のみ以下を設定:
# GSC_SITE_URL=https://tigerlabo.com/
# GA4_PROPERTY_ID=545818114
