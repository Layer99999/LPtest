# ─────────────────────────────────────────────────────────────
# keyword-discovery.py を --seed / --seed-file（Ubersuggest API直叩き）で使う場合のみ必要。
# --csv（画面からのエクスポート取り込み）だけを使うなら設定不要。
# ローカルで動かす場合はこのファイルを .env にコピーして値を入れる（.env はgit管理外）。
# ─────────────────────────────────────────────────────────────

UBERSUGGEST_API_KEY=
# 既定値のままで動かない場合、Ubersuggestアカウントの実際のAPI設定を確認して上書きする
# UBERSUGGEST_API_BASE=https://app.neilpatel.com/api
# UBERSUGGEST_LOC_ID=2392
# UBERSUGGEST_LANGUAGE=ja
